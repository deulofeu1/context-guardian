{
  "description": "Review and persist context before Claude Code compaction.",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/precompact.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
